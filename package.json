{
	"name": "@newfold-labs/wp-module-onboarding",
	"version": "4.0.12",
	"description": "Next-generation WordPress Onboarding for WordPress sites at Newfold Digital.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"author": {
		"name": "Alani Abdulrahman",
		"homepage": "https://alani.dev"
	},
	"engines": {
		"node": ">=22.11.0",
		"npm": ">=10.9.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"@wordpress/env": "^12.1.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/scripts": "^37.1.0",
		"eslint": "^10.14.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"tailwindcss": "^3.4.19",
		"webpack-merge": "^6.0.1"
	},
	"scripts": {
		"build": "wp-scripts build ./src/onboarding.js ./src/DesignStudio/onboarding-design-studio.js ./src/DesignStudio/onboarding-design-studio.css",
		"format": "wp-scripts format ./src",
		"start": "wp-scripts start ./src/onboarding.js ./src/DesignStudio/onboarding-design-studio.js ./src/DesignStudio/onboarding-design-studio.css",
		"set-version-bump": "npm run set-version-patch",
		"post-set-version": "rm -rf ./build",
		"lint:js": "wp-scripts lint-js ./src",
		"lint:js:fix": "wp-scripts lint-js ./src --fix",
		"test:unit": "npx wp-env run phpunit 'phpunit -c /var/www/html/wp-content/plugins//phpunit.xml --verbose'"
	},
	"dependencies": {
		"@newfold/js-utility-ui-analytics": "^1.4.0",
		"@newfold/ui-component-library": "^2.1.1",
		"@sentry/react": "^11.11.0",
		"@wordpress/api-fetch": "^8.1.0",
		"@wordpress/blob": "^5.0.0",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/block-library": "^12.1.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/core-data": "^9.1.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/editor": "^16.1.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/interface": "^11.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/url": "^5.0.0",
		"canvas-confetti": "^1.9.4",
		"lucide-react": "^1.69.0",
		"motion": "^14.10.1",
		"posthog-js": "^1.444.4"
	}
}
