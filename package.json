{
	"name": "@newfold-labs/wp-module-onboarding",
	"version": "4.0.10",
	"description": "Next-generation WordPress Onboarding for WordPress sites at Newfold Digital.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"author": {
		"name": "Alani Abdulrahman",
		"homepage": "https://alani.dev"
	},
	"engines": {
		"node": ">=22.11.0",
		"npm": ">=10.9.0"
	},
	"devDependencies": {
		"@wordpress/env": "^11.17.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/scripts": "^36.1.0",
		"eslint": "^10.13.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"tailwindcss": "^3.4.19",
		"webpack-merge": "^6.0.1"
	},
	"scripts": {
		"build": "wp-scripts build ./src/onboarding.js ./src/DesignStudio/onboarding-design-studio.js ./src/DesignStudio/onboarding-design-studio.css",
		"format": "wp-scripts format ./src",
		"start": "wp-scripts start ./src/onboarding.js ./src/DesignStudio/onboarding-design-studio.js ./src/DesignStudio/onboarding-design-studio.css",
		"set-version-bump": "npm run set-version-patch",
		"post-set-version": "rm -rf ./build",
		"lint:js": "wp-scripts lint-js ./src",
		"lint:js:fix": "wp-scripts lint-js ./src --fix",
		"test:unit": "npx wp-env run phpunit 'phpunit -c /var/www/html/wp-content/plugins//phpunit.xml --verbose'"
	},
	"dependencies": {
		"@newfold/js-utility-ui-analytics": "^1.4.0",
		"@newfold/ui-component-library": "^2.1.1",
		"@sentry/react": "^11.6.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/blob": "^5.0.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/block-library": "^11.2.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.41.0",
		"@wordpress/dom-ready": "^4.46.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "^6.24.0",
		"@wordpress/interface": "^10.3.0",
		"@wordpress/plugins": "^7.57.0",
		"@wordpress/url": "^5.0.0",
		"canvas-confetti": "^1.9.4",
		"lucide-react": "^1.59.0",
		"motion": "^14.4.0",
		"posthog-js": "^1.438.12"
	}
}
