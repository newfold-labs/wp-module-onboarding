#: build/4.0.12/onboarding.js:1
#, js-format
msgid "%s logo"
msgstr "Logo %s"

#. translators: %s is the brand display name (e.g. Bluehost, HostGator).
#: build/4.0.12/onboarding.js:3
msgid "I want to build"
msgstr "Eu quero construir"

#: build/4.0.12/onboarding.js:3
msgid "a photography portfolio with a booking page and gallery…"
msgstr "um portfólio de fotografia com página de reservas e galeria..."

#: build/4.0.12/onboarding.js:3
msgid "an online bakery with a menu and custom order form…"
msgstr "uma padaria online com cardápio e formulário de pedido personalizado..."

#: build/4.0.12/onboarding.js:3
msgid "a travel blog with a newsletter signup…"
msgstr "um blog de viagens com inscrição em uma newsletter..."

#: build/4.0.12/onboarding.js:3
msgid "a fitness coaching site with class schedules and pricing…"
msgstr "um site de coaching físico com horários e preços de aulas..."

#: build/4.0.12/onboarding.js:3
msgid "a restaurant site with an online menu and reservations…"
msgstr "um site de restaurante com cardápio online e reservas..."

#: build/4.0.12/onboarding.js:3
msgid "Build now"
msgstr "Construa agora"

#: build/4.0.12/onboarding.js:3
msgid "Tell us what kind of website you want to build"
msgstr "Conte para nós que tipo de site você quer criar"

#: build/4.0.12/onboarding.js:3
msgid "Or"
msgstr "Ou"

#: build/4.0.12/onboarding.js:3
msgid "Import an Existing WordPress Site"
