#. translators: %s is the brand name (e.g., Bluehost, HostGator)
#: build/4.0.12/onboarding.js:5
#, js-format
msgid "Let's migrate your existing site to %s"
msgstr "Vamos migrar seu site atual para %s"

#: build/4.0.12/onboarding.js:5
msgid "Let's migrate your existing site"
msgstr "Vamos migrar seu site atual"

#: build/4.0.12/onboarding.js:5
msgid "Please wait a few seconds while we get your new account ready to import your existing WordPress site."
msgstr "Por favor, aguarde alguns segundos enquanto preparamos sua nova conta para importar seu site WordPress existente."

